{
  "name": "timefrontiers/api-auth-client",
  "description": "Client-side API authentication and request signing",
  "type": "library",
  "license": "MIT",
  "keywords": ["api", "authentication", "hmac", "client", "signing"],
  "authors": [
    {
      "name": "TimeFrontiers",
      "email": "dev@timefrontiers.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "TimeFrontiers\\Auth\\Client\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TimeFrontiers\\Auth\\Client\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
    "check": [
      "@lint",
      "@test",
      "@analyse"
    ],
    "lint": "@php vendor/bin/parallel-lint src tests",
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
